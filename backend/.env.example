APP_NAME=IPGuard
APP_VERSION=1.0.0
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ipguard:replace_with_a_strong_local_password@127.0.0.1:5432/ipguard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted origins for QR authentication session binding
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local administrative authorization key for dev/management routes
DEV_ADMIN_KEY=ipguard-dev-admin-secret-key
