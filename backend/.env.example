APP_NAME=IPGuard
APP_VERSION=1.0.0
APP_ENV=development
DATABASE_URL=postgresql+psycopg://ipguard:replace_with_a_strong_local_password@127.0.0.1:5432/ipguard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted origins for QR authentication session binding
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local administrative authorization key for dev/management routes
DEV_ADMIN_KEY=ipguard-dev-admin-secret-key

# Milestone 3 — Secure Notes Master Key (Base64 of 32 cryptographically secure random bytes)
# In development, a fallback key is used if not set. In production, this key is MANDATORY.
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
NOTES_MASTER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Milestone 3 — Asset Vault Master Key (Base64 of 32 cryptographically secure random bytes)
# In development, a fallback key is used if not set. In production, this key is MANDATORY.
ASSET_VAULT_MASTER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Milestone 4 — PNG LSB Steganography & Digital Watermark Signing
# Private key is a Base64-encoded raw Ed25519 32-byte seed. Never commit actual private keys.
# Active key ID is the first 16 bytes of SHA-256(raw public key), lowercase hex.
# Public keys JSON maps key IDs to Base64 raw public keys for signature verification.
STEGO_SIGNING_PRIVATE_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
STEGO_ACTIVE_KEY_ID=0123456789abcdef0123456789abcdef
STEGO_PUBLIC_KEYS_JSON={"0123456789abcdef0123456789abcdef":"MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="}

# Resource limits (defaults: 50 MiB encoded PNG, 20 MP, 10,000 px per axis, 4 MiB payload)
STEGO_MAX_IMAGE_BYTES=52428800
STEGO_MAX_IMAGE_PIXELS=20000000
STEGO_MAX_IMAGE_DIMENSION=10000
STEGO_MAX_PAYLOAD_BYTES=4194304
